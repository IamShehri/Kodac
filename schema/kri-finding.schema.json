{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kodac.dev/schema/kri-finding.schema.json",
  "title": "Kodac KRI-R2 FindingRecord",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "findingIdentity",
    "claimKey",
    "review",
    "path",
    "summary",
    "contractClaim",
    "category",
    "severity",
    "confidenceBps",
    "evidenceRefs",
    "freshness",
    "state"
  ],
  "properties": {
    "version": { "const": "kri-r2-finding-v1" },
    "findingIdentity": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "claimKey": { "type": "string", "minLength": 1, "maxLength": 128 },
    "review": { "$ref": "#/$defs/reviewIdentity" },
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*//)[^\\u0000]+$"
    },
    "range": { "$ref": "#/$defs/range" },
    "summary": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "contractClaim": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "category": { "type": "string", "minLength": 1, "maxLength": 128 },
    "severity": { "enum": ["blocker", "critical", "high", "medium", "low", "info"] },
    "confidenceBps": { "type": "integer", "minimum": 0, "maximum": 10000 },
    "evidenceRefs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 1024 }
    },
    "freshness": { "enum": ["CURRENT", "STALE"] },
    "state": { "enum": ["NEW", "CONFIRMED", "REJECTED", "DUPLICATE", "STALE", "FIXED", "REVERIFIED"] }
  },
  "$defs": {
    "gitCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "reviewIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reviewRunId",
        "reviewerId",
        "reviewerVersion",
        "policyIdentity",
        "canonicalBase",
        "reviewedHead",
        "currentHead"
      ],
      "properties": {
        "reviewRunId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "reviewerId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "reviewerVersion": { "type": "string", "minLength": 1, "maxLength": 128 },
        "policyIdentity": { "type": "string", "minLength": 1, "maxLength": 128 },
        "canonicalBase": { "$ref": "#/$defs/gitCommit" },
        "reviewedHead": { "$ref": "#/$defs/gitCommit" },
        "currentHead": { "$ref": "#/$defs/gitCommit" }
      }
    },
    "range": {
      "type": "object",
      "additionalProperties": false,
      "required": ["startLine", "endLine"],
      "properties": {
        "startLine": { "type": "integer", "minimum": 1, "maximum": 10000000 },
        "endLine": { "type": "integer", "minimum": 1, "maximum": 10000000 }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "freshness": { "const": "CURRENT" } }, "required": ["freshness"] },
      "then": { "not": { "properties": { "state": { "const": "STALE" } }, "required": ["state"] } }
    },
    {
      "if": { "properties": { "freshness": { "const": "STALE" } }, "required": ["freshness"] },
      "then": { "properties": { "state": { "enum": ["STALE", "REJECTED", "DUPLICATE"] } } }
    }
  ]
}
