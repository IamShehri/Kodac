{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kodac.dev/schema/kdo-model-visible-request.schema.json",
  "title": "Kodac H2-R1 Model-Visible Request Snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "provider", "model", "messages", "tools", "messageCount", "toolCount", "totalMessageContentBytes", "modelVisibleBytes", "requestIdentity"],
  "properties": {
    "version": { "const": "kodac-model-visible-request-v1" },
    "provider": { "type": "string", "minLength": 1 },
    "model": { "type": "string", "minLength": 1 },
    "messages": { "type": "array", "maxItems": 512, "items": { "$ref": "#/$defs/message" } },
    "tools": { "type": "array", "maxItems": 256, "items": { "$ref": "#/$defs/tool" } },
    "messageCount": { "type": "integer", "minimum": 0, "maximum": 512 },
    "toolCount": { "type": "integer", "minimum": 0, "maximum": 256 },
    "totalMessageContentBytes": { "type": "integer", "minimum": 0, "maximum": 4194304 },
    "modelVisibleBytes": { "type": "integer", "minimum": 1, "maximum": 8388608 },
    "requestIdentity": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  },
  "$defs": {
    "json": {
      "oneOf": [
        { "type": "null" },
        { "type": "boolean" },
        { "type": "number" },
        { "type": "string" },
        { "type": "array", "items": { "$ref": "#/$defs/json" } },
        { "type": "object", "additionalProperties": { "$ref": "#/$defs/json" } }
      ]
    },
    "call": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "input"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "input": { "$ref": "#/$defs/json" }
      }
    },
    "message": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "content"],
      "properties": {
        "role": { "enum": ["system", "user", "assistant", "tool"] },
        "content": { "type": "string" },
        "name": { "type": "string", "minLength": 1 },
        "toolCallId": { "type": "string", "minLength": 1 },
        "toolCalls": { "type": "array", "maxItems": 128, "items": { "$ref": "#/$defs/call" } }
      }
    },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "capability", "description", "inputSchema"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "capability": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "inputSchema": { "type": "object", "additionalProperties": { "$ref": "#/$defs/json" } }
      }
    }
  }
}
