{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kodac.dev/schema/kri-review-run.schema.json",
  "title": "Kodac KRI-R3 Review Run Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "reviewRunId",
    "reviewRunIdentity",
    "status",
    "providerId",
    "providerVersion",
    "policyIdentity",
    "canonicalBase",
    "reviewedHead",
    "evaluatedHead",
    "contextBundleIdentity",
    "taskId",
    "instructionsIdentity",
    "acceptedClaimCount",
    "findingIdentities",
    "failureCode"
  ],
  "properties": {
    "version": { "const": "kri-r3-review-run-v1" },
    "reviewRunId": { "$ref": "#/$defs/sha256" },
    "reviewRunIdentity": { "$ref": "#/$defs/sha256" },
    "status": {
      "enum": ["COMPLETED", "STALE", "PROVIDER_FAILED", "TIMED_OUT", "INVALID_PROVIDER_OUTPUT"]
    },
    "providerId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "providerVersion": { "type": "string", "minLength": 1, "maxLength": 128 },
    "policyIdentity": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "description": "Aligned with the canonical KRI-R2 ReviewIdentity bound. The runtime applies the stricter UTF-8 byte bound."
    },
    "canonicalBase": { "$ref": "#/$defs/gitSha1" },
    "reviewedHead": { "$ref": "#/$defs/gitSha1" },
    "evaluatedHead": {
      "allOf": [
        { "$ref": "#/$defs/gitSha1" },
        {
          "description": "Runtime-owned post-provider current head. The runtime requires COMPLETED iff this equals reviewedHead and STALE iff it differs. JSON Schema 2020-12 cannot compare sibling string values directly."
        }
      ]
    },
    "contextBundleIdentity": { "$ref": "#/$defs/sha256" },
    "taskId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "instructionsIdentity": { "$ref": "#/$defs/sha256" },
    "acceptedClaimCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 64,
      "description": "Runtime additionally requires this value to equal findingIdentities.length."
    },
    "findingIdentities": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/sha256" }
    },
    "failureCode": {
      "enum": [null, "provider-error", "timeout", "invalid-output"]
    }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "enum": ["COMPLETED", "STALE"] } }, "required": ["status"] },
      "then": { "properties": { "failureCode": { "const": null } } }
    },
    {
      "if": { "properties": { "status": { "const": "PROVIDER_FAILED" } }, "required": ["status"] },
      "then": {
        "properties": {
          "failureCode": { "const": "provider-error" },
          "acceptedClaimCount": { "const": 0 },
          "findingIdentities": { "maxItems": 0 }
        }
      }
    },
    {
      "if": { "properties": { "status": { "const": "TIMED_OUT" } }, "required": ["status"] },
      "then": {
        "properties": {
          "failureCode": { "const": "timeout" },
          "acceptedClaimCount": { "const": 0 },
          "findingIdentities": { "maxItems": 0 }
        }
      }
    },
    {
      "if": { "properties": { "status": { "const": "INVALID_PROVIDER_OUTPUT" } }, "required": ["status"] },
      "then": {
        "properties": {
          "failureCode": { "const": "invalid-output" },
          "acceptedClaimCount": { "const": 0 },
          "findingIdentities": { "maxItems": 0 }
        }
      }
    }
  ],
  "$defs": {
    "gitSha1": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}