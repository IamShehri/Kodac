{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kodac.dev/schema/kri-adjudication.schema.json",
  "title": "Kodac KRI-R2 AdjudicationRecord",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "adjudicationIdentity",
    "findingIdentity",
    "previousStateIdentity",
    "resultingStateIdentity",
    "action",
    "previousState",
    "resultingState",
    "adjudicatorId",
    "evidenceRefs"
  ],
  "properties": {
    "version": { "const": "kri-r2-adjudication-v1" },
    "adjudicationIdentity": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "findingIdentity": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "previousStateIdentity": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "resultingStateIdentity": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "action": { "enum": ["CONFIRM", "REJECT", "MARK_DUPLICATE", "MARK_FIXED", "REVERIFY"] },
    "previousState": { "enum": ["NEW", "CONFIRMED", "REJECTED", "DUPLICATE", "STALE", "FIXED", "REVERIFIED"] },
    "resultingState": { "enum": ["NEW", "CONFIRMED", "REJECTED", "DUPLICATE", "STALE", "FIXED", "REVERIFIED"] },
    "adjudicatorId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "evidenceRefs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 1024 }
    },
    "duplicateOf": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "correctionRef": { "type": "string", "minLength": 1, "maxLength": 1024 },
    "reverificationRef": { "type": "string", "minLength": 1, "maxLength": 1024 }
  },
  "allOf": [
    {
      "if": { "properties": { "action": { "const": "MARK_DUPLICATE" } }, "required": ["action"] },
      "then": {
        "required": ["duplicateOf"],
        "not": { "anyOf": [{ "required": ["correctionRef"] }, { "required": ["reverificationRef"] }] }
      }
    },
    {
      "if": { "properties": { "action": { "const": "MARK_FIXED" } }, "required": ["action"] },
      "then": {
        "required": ["correctionRef"],
        "not": { "anyOf": [{ "required": ["duplicateOf"] }, { "required": ["reverificationRef"] }] }
      }
    },
    {
      "if": { "properties": { "action": { "const": "REVERIFY" } }, "required": ["action"] },
      "then": {
        "required": ["reverificationRef"],
        "not": { "anyOf": [{ "required": ["duplicateOf"] }, { "required": ["correctionRef"] }] }
      }
    },
    {
      "if": { "properties": { "action": { "enum": ["CONFIRM", "REJECT"] } }, "required": ["action"] },
      "then": {
        "not": {
          "anyOf": [
            { "required": ["duplicateOf"] },
            { "required": ["correctionRef"] },
            { "required": ["reverificationRef"] }
          ]
        }
      }
    }
  ]
}
