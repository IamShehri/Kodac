{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kodac.dev/schema/kdo-h4-r4b-b1-dormant-created-admission.schema.json",
  "title": "Kodac H4-R4B-B1 Dormant Created Admission",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "prepared",
    "observation",
    "permitIdentity",
    "reservationIdentity",
    "executionAttemptIdentity",
    "requirementIdentity",
    "workloadIdentity",
    "createOperationIdentity",
    "preparedIdentity",
    "containerId",
    "containerName",
    "bindingIdentity",
    "observationIdentity",
    "createdAdmissionIdentity"
  ],
  "properties": {
    "version": { "const": "kodac-h4-r4b-b1-created-admission-v1" },
    "prepared": { "$ref": "#/$defs/prepared" },
    "observation": { "$ref": "#/$defs/observation" },
    "permitIdentity": { "$ref": "#/$defs/sha256" },
    "reservationIdentity": { "$ref": "#/$defs/sha256" },
    "executionAttemptIdentity": { "$ref": "#/$defs/sha256" },
    "requirementIdentity": { "$ref": "#/$defs/sha256" },
    "workloadIdentity": { "$ref": "#/$defs/sha256" },
    "createOperationIdentity": { "$ref": "#/$defs/sha256" },
    "preparedIdentity": { "$ref": "#/$defs/sha256" },
    "containerId": { "$ref": "#/$defs/sha256" },
    "containerName": { "$ref": "#/$defs/containerName" },
    "bindingIdentity": { "$ref": "#/$defs/sha256" },
    "observationIdentity": { "$ref": "#/$defs/sha256" },
    "createdAdmissionIdentity": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "containerName": {
      "type": "string",
      "pattern": "^kodac-r4b-b1-[0-9a-f]{32}$"
    },
    "labels": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "io.kodac.binding-version",
        "io.kodac.requirement-identity",
        "io.kodac.workload-identity",
        "io.kodac.execution-attempt-identity",
        "io.kodac.r4b-b1-create-operation-identity"
      ],
      "properties": {
        "io.kodac.binding-version": { "const": "kodac-h4-r3f-docker-binding-v1" },
        "io.kodac.requirement-identity": { "$ref": "#/$defs/sha256" },
        "io.kodac.workload-identity": { "$ref": "#/$defs/sha256" },
        "io.kodac.execution-attempt-identity": { "$ref": "#/$defs/sha256" },
        "io.kodac.r4b-b1-create-operation-identity": { "$ref": "#/$defs/sha256" }
      }
    },
    "reservation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "permitIdentity", "executionAttemptIdentity", "reservationIdentity"],
      "properties": {
        "version": { "const": "kodac-h4-r4b-a-consumption-reservation-v1" },
        "permitIdentity": { "$ref": "#/$defs/sha256" },
        "executionAttemptIdentity": { "$ref": "#/$defs/sha256" },
        "reservationIdentity": { "$ref": "#/$defs/sha256" }
      }
    },
    "prepared": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "reservation",
        "permitIdentity",
        "reservationIdentity",
        "executionAttemptIdentity",
        "requirementIdentity",
        "workloadIdentity",
        "sourceReference",
        "sourceDigest",
        "entrypointExecutable",
        "argsIdentity",
        "nanoCpus",
        "memoryBytes",
        "memorySwapBytes",
        "runtimeName",
        "networkMode",
        "restartPolicy",
        "privileged",
        "tty",
        "createOperationIdentity",
        "containerName",
        "labels",
        "preparedIdentity"
      ],
      "properties": {
        "version": { "const": "kodac-h4-r4b-b1-create-prepared-v1" },
        "reservation": { "$ref": "#/$defs/reservation" },
        "permitIdentity": { "$ref": "#/$defs/sha256" },
        "reservationIdentity": { "$ref": "#/$defs/sha256" },
        "executionAttemptIdentity": { "$ref": "#/$defs/sha256" },
        "requirementIdentity": { "$ref": "#/$defs/sha256" },
        "workloadIdentity": { "$ref": "#/$defs/sha256" },
        "sourceReference": { "type": "string", "minLength": 1 },
        "sourceDigest": { "$ref": "#/$defs/digest" },
        "entrypointExecutable": { "type": "string", "pattern": "^/" },
        "argsIdentity": { "$ref": "#/$defs/sha256" },
        "nanoCpus": { "type": "integer", "minimum": 1 },
        "memoryBytes": { "type": "integer", "minimum": 1 },
        "memorySwapBytes": { "type": "integer", "minimum": 1 },
        "runtimeName": { "const": "runsc" },
        "networkMode": { "const": "none" },
        "restartPolicy": { "const": "no" },
        "privileged": { "const": false },
        "tty": { "const": false },
        "createOperationIdentity": { "$ref": "#/$defs/sha256" },
        "containerName": { "$ref": "#/$defs/containerName" },
        "labels": { "$ref": "#/$defs/labels" },
        "preparedIdentity": { "$ref": "#/$defs/sha256" }
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "socketEndpointIdentity",
        "executionAttemptIdentity",
        "requirementIdentity",
        "workloadIdentity",
        "createOperationIdentity",
        "containerId",
        "containerName",
        "bindingIdentity",
        "imageManifestDigest",
        "executable",
        "argsIdentity",
        "runtimeName",
        "networkMode",
        "networkAttachmentCount",
        "nanoCpus",
        "memoryBytes",
        "memorySwapBytes",
        "restartCount",
        "restartPolicy",
        "privileged",
        "tty",
        "running",
        "paused",
        "restarting",
        "dead",
        "pid",
        "labels",
        "observationIdentity"
      ],
      "properties": {
        "version": { "const": "kodac-h4-r4b-b1-dormant-docker-observation-v1" },
        "socketEndpointIdentity": { "$ref": "#/$defs/sha256" },
        "executionAttemptIdentity": { "$ref": "#/$defs/sha256" },
        "requirementIdentity": { "$ref": "#/$defs/sha256" },
        "workloadIdentity": { "$ref": "#/$defs/sha256" },
        "createOperationIdentity": { "$ref": "#/$defs/sha256" },
        "containerId": { "$ref": "#/$defs/sha256" },
        "containerName": { "$ref": "#/$defs/containerName" },
        "bindingIdentity": { "$ref": "#/$defs/sha256" },
        "imageManifestDigest": { "$ref": "#/$defs/digest" },
        "executable": { "type": "string", "pattern": "^/" },
        "argsIdentity": { "$ref": "#/$defs/sha256" },
        "runtimeName": { "const": "runsc" },
        "networkMode": { "const": "none" },
        "networkAttachmentCount": { "const": 0 },
        "nanoCpus": { "type": "integer", "minimum": 1 },
        "memoryBytes": { "type": "integer", "minimum": 1 },
        "memorySwapBytes": { "type": "integer", "minimum": 1 },
        "restartCount": { "const": 0 },
        "restartPolicy": { "const": "no" },
        "privileged": { "const": false },
        "tty": { "const": false },
        "running": { "const": false },
        "paused": { "const": false },
        "restarting": { "const": false },
        "dead": { "const": false },
        "pid": { "const": 0 },
        "labels": { "$ref": "#/$defs/labels" },
        "observationIdentity": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}
