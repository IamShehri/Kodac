{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kodac.dev/schema/kdo-h4-r4a-sandbox-execution-approval-binding.schema.json",
  "title": "Kodac H4-R4A Exact Sandbox Execution Approval Binding",
  "description": "Structural schema for the pure H4-R4A bridge between one canonical H4-R3B SandboxExecutionRequirement and one H4-R1 ApprovalRequest occurrence. Runtime validation remains authoritative for hostile JavaScript shapes and UTF-8 byte bounds. This schema does not represent an approval outcome or execution authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "requirement",
    "approvalRequest",
    "requirementIdentity",
    "workloadIdentity",
    "sourceIdentity",
    "sourceDigest",
    "entrypointIdentity",
    "resourcePolicyIdentity",
    "networkPolicyIdentity",
    "confinementRequestIdentity",
    "executionIntentIdentity",
    "workspaceIdentity",
    "requiredSemanticRuntimeClass",
    "downgradePolicy",
    "credentialBindingIdentity",
    "approvalCapability",
    "approvalInputDigest",
    "approvalRequestIdentity",
    "approvalRequestInstanceId",
    "bindingIdentity"
  ],
  "properties": {
    "version": { "const": "kodac-h4-r4a-exact-sandbox-approval-binding-v1" },
    "requirement": {
      "$ref": "https://kodac.dev/schema/kdo-h4-r3b-sandbox-backend-evidence.schema.json#/$defs/requirement"
    },
    "approvalRequest": { "$ref": "#/$defs/approvalRequest" },
    "requirementIdentity": { "$ref": "#/$defs/identity" },
    "workloadIdentity": { "$ref": "#/$defs/identity" },
    "sourceIdentity": { "$ref": "#/$defs/identity" },
    "sourceDigest": { "$ref": "#/$defs/digest" },
    "entrypointIdentity": { "$ref": "#/$defs/identity" },
    "resourcePolicyIdentity": { "$ref": "#/$defs/identity" },
    "networkPolicyIdentity": { "$ref": "#/$defs/identity" },
    "confinementRequestIdentity": { "$ref": "#/$defs/identity" },
    "executionIntentIdentity": { "$ref": "#/$defs/identity" },
    "workspaceIdentity": { "$ref": "#/$defs/identity" },
    "requiredSemanticRuntimeClass": { "enum": ["gvisor", "kata-firecracker", "kata-qemu"] },
    "downgradePolicy": { "const": "forbid" },
    "credentialBindingIdentity": { "type": "null" },
    "approvalCapability": { "const": "runtime.execute.sandbox" },
    "approvalInputDigest": { "$ref": "#/$defs/identity" },
    "approvalRequestIdentity": { "$ref": "#/$defs/identity" },
    "approvalRequestInstanceId": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\\u0000]+$",
      "description": "Exact H4-R1 one-shot request occurrence identifier. Runtime validation additionally enforces <=128 UTF-8 bytes."
    },
    "bindingIdentity": { "$ref": "#/$defs/identity" }
  },
  "$defs": {
    "identity": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "approvalIntent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capability", "paths", "inputDigest"],
      "properties": {
        "capability": { "const": "runtime.execute.sandbox" },
        "paths": {
          "type": "array",
          "maxItems": 0,
          "items": { "type": "string" }
        },
        "inputDigest": { "$ref": "#/$defs/identity" }
      }
    },
    "approvalRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "requestIdentity", "requestInstanceId", "intent"],
      "properties": {
        "version": { "const": "kodac-h4-r1-one-shot-approval-v1" },
        "requestIdentity": { "$ref": "#/$defs/identity" },
        "requestInstanceId": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\u0000]+$",
          "description": "Exact one-shot request occurrence identifier; runtime validation enforces <=128 UTF-8 bytes."
        },
        "intent": { "$ref": "#/$defs/approvalIntent" }
      }
    }
  }
}
