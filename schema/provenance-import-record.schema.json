{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kodac.dev/schema/provenance-import-record.schema.json",
  "title": "Kodac Provenance Import Record",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "record_id", "status", "classification", "upstream", "destination_paths", "license_review", "verification"],
  "properties": {
    "schema_version": {"const": 1},
    "record_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
    "status": {"enum": ["candidate", "reviewed", "authorized", "imported", "rejected"]},
    "classification": {"enum": ["COPY", "ADAPT", "VENDOR", "REIMPLEMENT", "INTEGRATE", "REFERENCE", "REJECT"]},
    "upstream": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "repository", "commit", "source_paths"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "repository": {"type": "string", "pattern": "^https://github\\.com/"},
        "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "source_paths": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "destination_paths": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "license_review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository_license", "path_scope_reviewed", "notice_required", "evidence"],
      "properties": {
        "repository_license": {"type": "string", "minLength": 1},
        "path_scope_reviewed": {"type": "boolean"},
        "notice_required": {"type": "boolean"},
        "evidence": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "excluded_paths": {"type": "array", "items": {"type": "string"}}
      }
    },
    "dependency_closure": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "kind", "disposition"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "kind": {"enum": ["source", "package", "runtime", "build", "tooling"]},
          "disposition": {"enum": ["import", "adapt", "package-dependency", "replace-with-kodac", "exclude", "reference-only"]},
          "license": {"type": ["string", "null"]},
          "notes": {"type": "string"}
        }
      }
    },
    "modifications": {"type": "array", "items": {"type": "string"}},
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["behavioral_tests_required", "license_check_required", "provenance_check_required"],
      "properties": {
        "behavioral_tests_required": {"type": "boolean"},
        "license_check_required": {"const": true},
        "provenance_check_required": {"const": true},
        "benchmark_ids": {"type": "array", "items": {"type": "string"}}
      }
    },
    "authorization": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "authorized_by": {"type": ["string", "null"]},
        "authorized_at": {"type": ["string", "null"]},
        "authorization_ref": {"type": ["string", "null"]}
      }
    },
    "notes": {"type": "array", "items": {"type": "string"}}
  }
}
