# OmniBridge Environment Configuration
# Copy to .env and fill in values. NEVER commit .env to version control.

# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=3000

# ---------------------------------------------------------------------------
# Compliance
# ---------------------------------------------------------------------------
COMPLIANCE_MODE=strict              # strict | lenient | off
AUDIT_SINK=console                  # console | s3
AUDIT_S3_BUCKET=                    # S3 bucket for audit logs (HIPAA object-lock)
AUDIT_S3_PREFIX=omni-bridge/audit-logs
RETENTION_DAYS=2555                 # 7 years for HIPAA
PII_REDACTION=true

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------
AUTH_PROVIDER=mock                  # oauth2 | saml | mock  (use 'mock' for local dev)
AUTH_JWT_SECRET=change-me-in-production-use-a-real-secret
AUTH_ISSUER=                        # OAuth2 issuer URL
AUTH_CLIENT_ID=                     # OAuth2 client ID
AUTH_CLIENT_SECRET=                 # OAuth2 client secret
SAML_ENTRY_POINT=                   # SAML IdP entry point URL
SAML_CERT=                          # SAML IdP signing certificate (PEM)

# ---------------------------------------------------------------------------
# FHIR Backend
# ---------------------------------------------------------------------------
FHIR_BASE_URL=http://localhost:8080/fhir
FHIR_AUTH_TOKEN=                    # Bearer token if FHIR server requires auth
FHIR_TIMEOUT_MS=30000

# ---------------------------------------------------------------------------
# Observability
# ---------------------------------------------------------------------------
LOG_LEVEL=info                      # debug | info | warn | error
OTEL_EXPORTER_OTLP_ENDPOINT=       # OpenTelemetry collector endpoint
DATADOG_API_KEY=                    # Datadog API key (optional)

# ---------------------------------------------------------------------------
# Cache / Rate Limit
# ---------------------------------------------------------------------------
REDIS_URL=                          # redis://... — enables distributed rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120

# ---------------------------------------------------------------------------
# CORS
# ---------------------------------------------------------------------------
CORS_ORIGIN=*

# ---------------------------------------------------------------------------
# Fly.io / Infrastructure
# ---------------------------------------------------------------------------
FLY_APP_NAME=omni-bridge            # Set via: fly launch --name omni-bridge
FLY_REGION=iad                      # Primary region
